# App
APP_NAME=SmartGrow AI Backend
ENVIRONMENT=development
DEBUG=true

# Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=smartgrow_db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# CORS (Flutter app origins, comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# --- Model 1: Crop-Water Response (units: moisture % VWC, volume mL, delays seconds)
WATER_RESPONSE_MODEL_PATH=app/ml/artifacts/water_response.joblib
WATER_RESPONSE_MIN_TRAINING_ROWS=30
COCOPEAT_SATURATION_MOISTURE=70.0      # baseline model cap, % VWC - set from your sensor calibration
BASELINE_MOISTURE_GAIN_PER_100ML=8.0   # baseline gain, % points per 100 mL at 0% pre-moisture
DEFAULT_POST_MEASURE_DELAY_S=900

# --- Model 2: Response-Deviation / Fault
DEVIATION_MIN_TOLERANCE=3.0            # % points, floor for normalising the deviation
DEVIATION_ANOMALY_Z=1.0                # |z| above this = response anomaly
DEVIATION_CRITICAL_Z=2.5               # |z| above this = critical severity
NO_FLOW_THRESHOLD_LPM=0.05             # L/min
INTERMITTENT_FLOW_CV=0.5
MIN_MEANINGFUL_CHANGE=1.0              # % points
FAULT_CLASSIFIER_PATH=app/ml/artifacts/fault_classifier.joblib

# --- Model 3: Adaptive Irrigation Policy
POLICY_CANDIDATE_VOLUMES_ML=[0,50,100,150,200]   # JSON list, mL
POLICY_HORIZON_MINUTES=60
POLICY_DRYING_LOOKBACK_HOURS=3.0
POLICY_TARGET_MARGIN=2.0               # % points above optimal_min
POLICY_MIN_INTERVAL_MINUTES=60
POLICY_MAX_DAILY_VOLUME_ML=1000
POLICY_FAULT_GATE_CONFIDENCE=0.6
POLICY_EXPLORATION_RATE=0.0            # >0 only during data-collection experiments
POLICY_DEFAULT_OPTIMAL_MIN=45.0        # % VWC, used only when no thresholds row exists
POLICY_DEFAULT_OPTIMAL_MAX=65.0
POLICY_SCHEDULER_ENABLED=false
POLICY_SCHEDULER_INTERVAL_MINUTES=15
POLICY_SCHEDULER_TRAY_IDS=             # comma separated, e.g. tray-1,tray-2,tray-3
