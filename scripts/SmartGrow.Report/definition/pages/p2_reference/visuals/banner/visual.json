                      "fontWeight": "bold",
                      "fontSize": "24pt",
                      "color": "#FFFFFF"
                    }
                  },
                  {
                    "value": "   Seed compatibility and environment thresholds",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#C8E6C9"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1B5E20'"
                    }
                  }
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
