table SeedCompatibility
	lineageTag: 701b0c89-47f8-4352-a81a-43bd7db26296

	measure 'Suitability Rating' = SELECTEDVALUE(SeedCompatibility[Suitability])
		lineageTag: 523daa57-9279-4c39-afba-7c98afa0ec7a

	measure 'Suitability Color' =
			SWITCH(
			    SELECTEDVALUE(SeedCompatibility[Suitability]),
			    "Good", "#2E9E6B",
			    "Fair", "#B8A23A",
			    "Poor", "#C77D2E",
			    "Avoid", "#B5483D",
			    "#10382C"
			)
		lineageTag: 3e630fc6-bfd5-431f-9875-939810e9c715

	column Seed
		dataType: string
		lineageTag: 05243060-061f-4f08-803e-99255e18cb4a
		summarizeBy: none
		sourceColumn: Seed

	column Substrate
		dataType: string
		lineageTag: 56640e55-8908-4309-80b0-d3501c6b127b
		summarizeBy: none
		sourceColumn: Substrate

	column Suitability
		dataType: string
		lineageTag: 06cf7998-d1d9-4ca4-b3a6-2c581733b1c8
		summarizeBy: none
		sourceColumn: Suitability

	partition SeedCompatibility = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [Seed = text, Substrate = text, Suitability = text],
				        {
				            {"mustard", "cocopeat", "Good"},
				            {"mustard", "tissue paper", "Good"},
				            {"mustard", "compost", "Good"},
				            {"radish", "cocopeat", "Good"},
				            {"radish", "tissue paper", "Good"},
				            {"radish", "compost", "Good"},
				            {"fenugreek", "cocopeat", "Good"},
				            {"fenugreek", "tissue paper", "Good"},
				            {"fenugreek", "compost", "Good"},
				            {"coriander", "cocopeat", "Good"},
				            {"coriander", "tissue paper", "Poor"},
				            {"coriander", "compost", "Good"},
				            {"amaranth", "cocopeat", "Good"},
				            {"amaranth", "tissue paper", "Poor"},
				            {"amaranth", "compost", "Good"},
				            {"green gram", "cocopeat", "Good"},
				            {"green gram", "tissue paper", "Fair"},
				            {"green gram", "compost", "Good"},
				            {"sunflower", "cocopeat", "Good"},
				            {"sunflower", "tissue paper", "Avoid"},
				            {"sunflower", "compost", "Good"},
				            {"pea", "cocopeat", "Good"},
				            {"pea", "tissue paper", "Avoid"},
				            {"pea", "compost", "Good"}
				        }),
				    Result = Source
				in
				    Result

	annotation PBI_ResultType = Table
