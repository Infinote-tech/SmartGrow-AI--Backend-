	partition FaultEvents = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [fault_id = text, timestamp = datetime, esp32_id = text, tray_id = text, fault_type = text, fault_source = text, severity = text, sensor_value = number, expected_min = number, expected_max = number, anomaly_score = number, fault_probability = number, detected_by = text, recommended_action = text, automatic_action = text, fault_status = text, resolved_at = datetime, resolution_reason = text, irrigation_id = text, response_deviation = number, fault_hypothesis = text, fault_confidence = number, flow_class = text, response_class = text, diagnostic_action = text, recovery_action = text, recovery_success = logical, injected = logical],
				        {
				            {"6329cfd3606de4eb3f0121f3e35c18a0", #datetime(2026, 9, 29, 14, 35, 20), "esp32-01", "tray-2", "response_anomaly", "pump", "warning", 52.58, 53.41, 59.41, 1.275, 0.7, "rule", "Check reservoir level, pump power and inlet line", "irrigation paused for tray", "resolved", #datetime(2026, 9, 29, 17, 5, 20), "Cleared the inlet line", "d526e8f999e4226426afd434d4cf50a7", -3.826, "pump_tank_blockage", 0.7, "no_flow", "no_change", "Check reservoir level, pump power and inlet line", "Flushed inlet line and refilled reservoir", true, false},
				            {"4f7d39dad19e2a95780e21047a54c2e3", #datetime(2026, 9, 30, 9, 18, 20), "esp32-01", "tray-3", "response_anomaly", "sensor", "critical", 76.97, 60.63, 65.63, 4.614, 0.8, "rule", "Check for pooling, leaks near sensor, sensor drift", "irrigation paused for tray", "resolved", #datetime(2026, 10, 1, 11, 18, 20), "Moved the sensor away from the drip point", "75fc74c45de7818bb5da24688c6f5a9c", 13.842, "leakage_or_sensor", 0.8, "normal", "excessive", "Check for pooling, leaks near sensor, sensor drift", "Reduced next volume; re-seated sensor", true, false},
				            {"54ebef65b79692bbbf4e72cb157f2cc4", #datetime(2026, 10, 1, 7, 21, 20), "esp32-01", "tray-1", "response_anomaly", "valve", "warning", 58.31, 59.08, 64.08, 1.089, 0.7, "rule", "Check solenoid operation, tubing kinks, air in line", "irrigation paused for tray", "active", null, null, "77f0613902c4b76f0bab24821262afca", -3.266, "valve_tubing_system", 0.7, "intermittent", "no_change", "Check solenoid operation, tubing kinks, air in line", "Cycle valve; inspect tubing", null, false},
				            {"dd0460ebc620f253c7a1f2640bd30ece", #datetime(2026, 10, 2, 6, 31, 20), "esp32-01", "tray-2", "response_anomaly", "sensor", "warning", 52.25, 54.4, 59.4, 1.549, 0.7, "rule", "Check emitter placement, sensor contact with media, media dryness/hydrophobicity", "irrigation paused for tray", "active", null, null, "35b6a52ac83c86b7e202fbed0d5840cd", -4.648, "distribution_sensor_media", 0.7, "normal", "no_change", "Check emitter placement, sensor contact with media, media dryness/hydrophobicity", "Re-seat sensor; inspect distribution; manual watering check", null, false}
				        }),
				    Step0 = Table.AddColumn(Source, "Date", each DateTime.Date([timestamp]), type date),
				    Step1 = Table.AddColumn(Step0, "Hypothesis", each Text.Proper(Text.Replace([fault_hypothesis], "_", " ")), type text),
				    Step2 = Table.AddColumn(Step1, "Status", each Text.Proper(Text.Replace([fault_status], "_", " ")), type text),
				    Step3 = Table.AddColumn(Step2, "Severity Label", each Text.Proper(Text.Replace([severity], "_", " ")), type text),
				    Step4 = Table.AddColumn(Step3, "Hours To Resolve", each if [resolved_at] = null then null else Duration.TotalHours([resolved_at] - [timestamp]), type number),
				    Result = Step4
				in
				    Result

	annotation PBI_ResultType = Table
