table FaultEvents
	lineageTag: 6c72d4e9-f818-4397-82d6-1b99f38b26be

	measure 'Total Faults' = COUNTROWS(FaultEvents)
		formatString: #,0
		lineageTag: de2e99d1-7343-4591-89d0-60526d9b05cc

	measure 'Active Faults' = CALCULATE(COUNTROWS(FaultEvents), FaultEvents[fault_status] = "active") + 0
		formatString: #,0
		lineageTag: 715e8281-0a16-4bba-86e5-f7efdb65d225

	measure 'Critical Faults' = CALCULATE(COUNTROWS(FaultEvents), FaultEvents[severity] = "critical") + 0
		formatString: #,0
		lineageTag: be39b928-d4fe-407a-8c49-a6184a1e21c3

	measure 'Resolved %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FaultEvents), FaultEvents[fault_status] = "resolved"),
			    COUNTROWS(FaultEvents)
			)
		formatString: 0%
		lineageTag: e866f3f6-279a-4354-9a2e-e3ad5b3f4c35

	measure 'Avg Hours To Resolve' = AVERAGE(FaultEvents[Hours To Resolve])
		formatString: 0.0" h"
		lineageTag: 7a0b259e-67c2-43da-96cf-e49bc2dfbdec

	measure 'Avg Fault Confidence' = AVERAGE(FaultEvents[fault_confidence])
		formatString: 0%
		lineageTag: b6a50cea-16f6-4bad-aa0c-3edcd6103cc4

