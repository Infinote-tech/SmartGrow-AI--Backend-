				            {"6513270e269e0d37f2a74de452e6b438", "tray-1", "radish", "cocopeat", #date(2026, 9, 24), #date(2026, 10, 5), null, 25.0, "growing"},
				            {"d23f0824128b2f330c5c7fd0a6a3a450", "tray-2", "mustard", "compost", #date(2026, 9, 23), #date(2026, 10, 4), null, 20.0, "growing"},
