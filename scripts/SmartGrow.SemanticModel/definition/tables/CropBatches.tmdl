table CropBatches
	lineageTag: 789b8967-21cb-4723-91d5-dd9f049cd991

	measure 'Active Batches' = CALCULATE(COUNTROWS(CropBatches), CropBatches[batch_status] <> "harvested") + 0
		formatString: #,0
		lineageTag: bb1d4f70-3836-4a27-9b66-714ba6891401

	measure 'Days After Sowing' = DATEDIFF(MIN(CropBatches[planting_date]), CALCULATE(MAX(Dates[Date]), ALL(Dates)), DAY)
		formatString: 0
		lineageTag: bb17d613-3d7d-4587-a1b8-5876875cac1f

	column batch_id
