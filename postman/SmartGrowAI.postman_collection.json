              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.environment.set('user_id', body.id); }",
                  "pm.test('Status 201 or 409 (409 = already registered, fine on re-runs)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
