    {
      "name": "Crop-Water Response (Model 1)",
      "item": [
        {
          "name": "Predict Water Response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ml/water-response/predict",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ml",
                "water-response",
                "predict"
              ]
            },
            "description": "Model 1: expected moisture after irrigating `water_volume` mL (median + 10th/90th percentile interval + confidence), stored in model_outputs. Optional overrides: batch_id, seed_type, media_type, growth_stage (germination | blackout | early_growth | active_growth | pre_harvest), temperature \u00b0C, humidity % RH, light_intensity lux, timestamp. Anything omitted is resolved from the tray's latest sensor reading and active crop batch. model_version is baseline-v0 until a trained artifact exists (gbr-q-<date>).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tray_id\": \"{{tray_id}}\",\n  \"water_volume\": 100,\n  \"pre_irrigation_moisture\": 42.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.output_id) { pm.environment.set('output_id', body.output_id); }",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Response Deviation & Faults (Model 2)",
      "item": [
        {
          "name": "Link Irrigation Response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/irrigation-logs/{{irrigation_id}}/response",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "irrigation-logs",
                "{{irrigation_id}}",
                "response"
              ]
            },
            "description": "Send the measured result of an irrigation event (needs pre_irrigation_moisture on the log). The server computes actual_response, takes Model 1's expectation, sets expected_response and response_deviation, updates the linked model output and runs Model 2. This example (no flow, no moisture change) should raise a pump_tank_blockage fault. post_irrigation_moisture is % VWC; avg_flow_rate L/min; delays in seconds.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"post_irrigation_moisture\": 43.0,\n  \"post_measured_after_s\": 900,\n  \"avg_flow_rate\": 0.0,\n  \"flow_cv\": 0.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.deviation && body.deviation.fault_event) { pm.environment.set('fault_id', body.deviation.fault_event.fault_id); }",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Evaluate Response Deviation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ml/response-deviation/evaluate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ml",
                "response-deviation",
                "evaluate"
              ]
            },
            "description": "Re-run Model 2 for an irrigation event whose response is already linked. Returns z, is_anomaly, severity, flow_class, response_class, fault_hypothesis, fault_confidence, actions and the fault event if one was created.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"irrigation_id\": \"{{irrigation_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve Fault Event",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fault-events/{{fault_id}}/resolve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fault-events",
                "{{fault_id}}",
                "resolve"
              ]
            },
            "description": "Sets fault_status = resolved and resolved_at = now. 404 for an unknown fault_id, 409 if already resolved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution_reason\": \"Cleared blockage in the inlet line\",\n  \"recovery_action\": \"Flushed inlet line and refilled reservoir\",\n  \"recovery_success\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 409 (409 = already resolved)', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Adaptive Irrigation Policy (Model 3)",
      "item": [
        {
          "name": "Decide Irrigation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/policy/trays/{{tray_id}}/decide",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "policy",
                "trays",
                "{{tray_id}}",
                "decide"
              ]
            },
            "description": "Model 3: irrigate / wait / hold_and_inspect for the tray, with the volume (mL), confidence, reason codes and every candidate volume that was simulated. Recommendation only - nothing is actuated and no irrigation log is created. Needs a sensor reading less than 2 h old (soil_moisture, % VWC)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.output_id) { pm.environment.set('output_id', body.output_id); }",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest Decision",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/policy/trays/{{tray_id}}/latest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "policy",
                "trays",
                "{{tray_id}}",
                "latest"
              ]
            },
            "description": "The most recent adaptive_irrigation_policy output for the tray (404 if none yet)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
